{
    "name": "obsidian-antra",
    "version": "0.1.1",
    "description": "Create dynamic template-based resources with wiki-style infoboxes for Obsidian.",
    "main": "main.js",
    "type": "module",
    "author": "ChildWax",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/atomic-junky/antra-workspace.git"
    },
    "bugs": {
        "url": "https://github.com/atomic-junky/antra-workspace/issues"
    },
    "homepage": "https://github.com/atomic-junky/antra-workspace#readme",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint .",
        "svelte-check": "svelte-check --tsconfig tsconfig.json"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "template",
        "infobox",
        "wiki"
    ],
    "license": "MIT",
    "devDependencies": {
        "@codemirror/state": "6.7.6",
        "@codemirror/view": "6.43.15",
        "@eslint/js": "^10.0.1",
        "@types/node": "26.6.6",
        "esbuild": "^0.28.2",
        "esbuild-svelte": "^0.9.5",
        "eslint": "^10.15.0",
        "eslint-plugin-obsidianmd": "^0.6.0",
        "globals": "^17.14.0",
        "jiti": "^2.7.0",
        "obsidian": "^1.14.4",
        "svelte": "^5.59.1",
        "svelte-check": "^4.7.8",
        "svelte-preprocess": "^6.0.5",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.73.0"
    },
    "dependencies": {},
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
